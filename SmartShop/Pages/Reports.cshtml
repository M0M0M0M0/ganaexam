@page
@model ReportsModel
@{
    ViewData["Title"] = "Review report";
    var totalReviews = Model.Rows.Sum(r => r.TotalReviews);
    var totalPositive = Model.Rows.Sum(r => r.Positive);
    var overallAverage = totalReviews == 0 ? 0 : Model.Rows.Sum(r => r.AverageRating * r.TotalReviews) / totalReviews;
}

<div class="page-head">
    <div>
        <div class="eyebrow">Admin · Insights</div>
        <h1>Review report</h1>
        <p class="subtitle">Customer sentiment for each product, analyzed by Gemini.</p>
    </div>
    <div class="legend" aria-hidden="true">
        <span><i class="pos"></i>Positive</span>
        <span><i class="neg"></i>Negative</span>
        <span><i class="neu"></i>Neutral</span>
    </div>
</div>

<section class="stats">
    <div class="card stat">
        <div class="stat-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div><div class="stat-label">Total reviews</div><div class="stat-value">@totalReviews</div></div>
    </div>
    <div class="card stat">
        <div class="stat-icon pos">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>
        </div>
        <div><div class="stat-label">Positive</div><div class="stat-value">@(totalReviews == 0 ? 0 : (int)Math.Round(100.0 * totalPositive / totalReviews))<small>%</small></div></div>
    </div>
    <div class="card stat">
        <div class="stat-icon star">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <div><div class="stat-label">Average rating</div><div class="stat-value">@Ui.OneDecimal(overallAverage)<small> / 5</small></div></div>
    </div>
    <div class="card stat">
        <div class="stat-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/></svg>
        </div>
        <div><div class="stat-label">Products reviewed</div><div class="stat-value">@Model.Rows.Count<small> / @Model.Products.Count</small></div></div>
    </div>
</section>

<section class="card">
    <div class="card-head">
        <div>
            <h2>Reviews by product</h2>
        </div>
    </div>
    @if (Model.Rows.Count == 0)
    {
        <p class="empty">No reviews yet.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="report">
                <thead>
                <tr>
                    <th>No</th>
                    <th>Product name</th>
                    <th class="num">Total reviews</th>
                    <th class="num">Positive</th>
                    <th class="num">Negative</th>
                    <th class="num">Neutral</th>
                    <th>Sentiment</th>
                    <th class="num">Average rating</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.Rows)
                {
                    var category = Model.Products.FirstOrDefault(p => p.ProductName == row.ProductName)?.Category ?? "";
                    <tr>
                        <td class="no">@row.No</td>
                        <td>
                            <div class="product-cell">
                                <span class="thumb @Ui.CategoryClass(category)"><partial name="_CategoryIcon" model="(category, 18)" /></span>
                                @row.ProductName
                            </div>
                        </td>
                        <td class="num"><strong>@row.TotalReviews</strong></td>
                        <td class="num"><span class="pill @(row.Positive > 0 ? "pos" : "zero")">@row.Positive</span></td>
                        <td class="num"><span class="pill @(row.Negative > 0 ? "neg" : "zero")">@row.Negative</span></td>
                        <td class="num"><span class="pill @(row.Neutral > 0 ? "neu" : "zero")">@row.Neutral</span></td>
                        <td>
                            <div class="sentiment-bar" title="@row.Positive positive · @row.Negative negative · @row.Neutral neutral">
                                <span class="pos" style="width:@Ui.Percent(row.Positive, row.TotalReviews)%"></span>
                                <span class="neu" style="width:@Ui.Percent(row.Neutral, row.TotalReviews)%"></span>
                                <span class="neg" style="width:@Ui.Percent(row.Negative, row.TotalReviews)%"></span>
                            </div>
                        </td>
                        <td class="num">
                            <span class="rating">
                                <span class="stars" aria-hidden="true"><span style="width:@Ui.Percent(row.AverageRating, 5)%"></span></span>
                                <strong>@Ui.OneDecimal(row.AverageRating)</strong>
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card" style="margin-top:24px">
    <div class="card-head">
        <div>
            <h2>Add a customer review</h2>
            <p>Gemini reads the review, detects the sentiment and writes a short summary.</p>
        </div>
    </div>
    <form id="review-form" class="card-body form-grid">
        <div class="field">
            <label for="productId">Product</label>
            <select id="productId" name="productId">
                @foreach (var p in Model.Products)
                {
                    <option value="@p.ProductId">@p.ProductName</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="customerName">Customer name</label>
            <input id="customerName" name="customerName" required maxlength="64" placeholder="e.g. Nguyen Van A" />
        </div>
        <div class="field">
            <label>Rating</label>
            <div class="star-input" role="radiogroup" aria-label="Rating">
                @for (var i = 5; i >= 1; i--)
                {
                    <input type="radio" id="star@(i)" name="rating" value="@i" checked="@(i == 5)" />
                    <label for="star@(i)" title="@i star@(i > 1 ? "s" : "")">★</label>
                }
            </div>
        </div>
        <div class="field full">
            <label for="content">Review</label>
            <textarea id="content" name="content" required maxlength="1000" placeholder="What did the customer think about the product?"></textarea>
        </div>
        <div class="form-actions full">
            <button type="submit" class="btn ai">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>
                <span>Analyze &amp; save</span>
            </button>
            <div id="review-result" class="alert" role="status"></div>
        </div>
    </form>
</section>

@section Scripts {
<script>
const form = document.getElementById('review-form');
const alertBox = document.getElementById('review-result');

function showAlert(type, text) {
    alertBox.className = 'alert show ' + type;
    alertBox.textContent = text;
}

form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector('button');
    const label = button.querySelector('span');
    const data = Object.fromEntries(new FormData(form));
    data.productId = Number(data.productId);
    data.rating = Number(data.rating);

    button.disabled = true;
    label.textContent = 'Analyzing...';
    button.querySelector('svg').outerHTML = '<span class="spinner"></span>';
    showAlert('info', 'Gemini is analyzing the review...');
    try {
        const res = await fetch('/api/reviews/analyze', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data)
        });
        const body = await res.json();
        if (!res.ok) throw new Error(body.detail || body.title || res.statusText);
        showAlert('success', `Saved as ${body.sentiment} (confidence ${Math.round(body.score * 100)}%) — ${body.summary}`);
        setTimeout(() => location.reload(), 1800);
    } catch (err) {
        showAlert('error', err.message);
        button.disabled = false;
        label.textContent = 'Analyze & save';
        button.querySelector('.spinner').outerHTML =
            '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.2 6.6L21 11l-6.8 2.4L12 20l-2.2-6.6L3 11l6.8-2.4z"/></svg>';
    }
});
</script>
}
